{
	"name": "templates",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"postinstall": "cd ../backend && php artisan deps:versions 2>/dev/null || true",
		"dev": "concurrently 'node --inspect=0 node_modules/next/dist/bin/next dev' 'chokidar \"src/utils/**/*.js\" --ignore \"/src/utils/manual/\" --initial --silent --command \"pnpm exec node rollup.config.mjs || true\"'",
		"wev": "concurrently 'node --inspect=0 node_modules/next/dist/bin/next dev --webpack' 'chokidar \"src/utils/**/*.js\" --ignore \"/src/utils/manual/\" --initial --silent --command \"pnpm exec node rollup.config.mjs || true\"'",
		"build": "next build",
		"start": "next start",
		"stop": "pkill -9 ^next-server && echo 'Server successfully killed'",
		"prebuild": "node scripts/generate-api.mjs",
		"predev": "node scripts/generate-api.mjs"
	},
	"dependencies": {
		"@next/third-parties": "^16.4.3",
		"@popperjs/core": "^2.11.8",
		"@stripe/react-stripe-js": "^7.0.1",
		"@stripe/stripe-js": "^10.2.0",
		"@tabler/icons-react": "3.49.0",
		"bootstrap": "5.2.3",
		"clsx": "^2.1.1",
		"echarts": "^6.1.0",
		"framer-motion": "^14.9.0",
		"html-react-parser": "6.1.8",
		"intl-tel-input": "^29.5.10",
		"isomorphic-dompurify": "^4.6.0",
		"motion": "^14.9.0",
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.107.1",
		"sharp": "^0.35.5",
		"swiper": "^14.4.0",
		"swr": "^2.5.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@parcel/watcher": "^2.6.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-virtual": "^3.0.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^10.0.6",
		"cross-env": "^10.1.0",
		"onchange": "^7.1.0",
		"postcss": "^8.5.32",
		"postcss-reporter": "^7.1.0",
		"rollup": "^4.67.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
